{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ode",
  "version": "0.1.0",
  "identifier": "dev.ode.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ode",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Moritz Schäfer",
    "category": "Music",
    "shortDescription": "Soundboard mit Mischpult und virtuellem Mikrofon",
    "longDescription": "Ode mischt Mikrofon, Sounds und Musik und gibt alles über ein virtuelles Kabel (VB-CABLE) als Mikrofon an Discord und Spiele weiter.",
    "copyright": "© 2026 Moritz Schäfer",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Ode"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
